                            <string notr="true">/* Base style for the progress bar */
QProgressBar {
    border: none;                   /* Remove border */
    border-radius: 2px;            /* Rounded corners */
    background-color: #fff;      /* Light gray background */
    text-align: center;             /* Center the text */
    color: transparent;  
    height: 2px;  
}
/* Style for the progress chunk (filled part) */
QProgressBar::chunk {
    background-color: #3366FF;      /* Blue color for the progress */
    border-radius: 2px;            /* Match rounded corners */
}</string>
